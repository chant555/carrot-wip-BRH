-  # enforce max cache size
-  cache_files = [f for f in CACHE_DIR.rglob('*') if f.is_file()]
-  cache_files.sort(key=lambda f: f.stat().st_mtime)
-  cache_size = sum(f.stat().st_size for f in cache_files)
