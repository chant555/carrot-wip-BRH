+# Full reset of the incremental build. Outputs can be corrupted in place and
+# /data/scons_cache can hand the corrupted result back, so clear build state and
+# cache together; every target is then rebuilt from source.
+function reset_build_state {
+  rm -rf "$DIR/.sconsign.dblite" /data/scons_cache "$DIR/prebuilt"
+  FORCE_REBUILD=1
+}
+
+# A build interrupted while cythonizing leaves an empty acados_ocp_solver_pyx.c
+# (also pushed into the cache). scons keeps treating it as up to date and links
+# it into a module with no init function, so plannerd crash-loops on import and
+# engagement is impossible. Only judge outputs that exist (a first build has
+# none) and only by file contents, so the check cannot depend on the Python env.
+AUTORESET_STAMP="/data/build_autoreset.stamp"
+
+function check_mpc_solvers {
+  local lib gen broken="" head
+  for lib in longitudinal_mpc_lib lateral_mpc_lib; do
+    gen="$DIR/openpilot/selfdrive/controls/lib/$lib/c_generated_code"
+    if [ -e "$gen/acados_ocp_solver_pyx.c" ] && [ ! -s "$gen/acados_ocp_solver_pyx.c" ]; then
+      broken="$broken $lib:empty-c"
+    fi
+    if [ -f "$gen/acados_ocp_solver_pyx.so" ] && ! grep -qa PyInit_acados_ocp_solver_pyx "$gen/acados_ocp_solver_pyx.so"; then
+      broken="$broken $lib:no-PyInit"
+    fi
+  done
+  [ -z "$broken" ] && return 0
+
+  # At most one automatic reset per commit: if a full rebuild did not fix it,
+  # the cause is elsewhere and resetting on every boot would only slow boots.
+  head="$(git -C "$DIR" rev-parse HEAD 2>/dev/null)"
+  if [ -n "$head" ] && [ "$(cat "$AUTORESET_STAMP" 2>/dev/null)" = "$head" ]; then
+    echo "MPC solver outputs still broken after an automatic reset:$broken"
+    return 0
+  fi
+  echo "MPC solver outputs are broken:$broken; resetting build state and cache"
+  echo -n "$head" > "$AUTORESET_STAMP"
+  reset_build_state
+}
+
+# Written by the web UI / recovery "Rebuild All". Lives outside the repo so git
+# reset/clean cannot drop it, and needs nothing but a file write to request.
+REBUILD_REQUEST="/data/rebuild_all.request"
+REBUILD_LOG="/data/rebuild_all.last.log"
+
+function consume_rebuild_request {
+  [ -f "$REBUILD_REQUEST" ] || return 0
+  # Consume first so a failing build can never turn into a reboot loop.
+  rm -f "$REBUILD_REQUEST"
+  echo "Rebuild All requested: clearing build outputs, build state and cache"
+  {
+    date
+    # Best effort: removes generated outputs. It must not gate the reset below,
+    # because the environment it needs may be exactly what is broken.
+    if ! (cd "$DIR" && timeout 600 scons -c); then
+      echo "scons -c failed; continuing with state/cache reset"
+    fi
+  } > "$REBUILD_LOG" 2>&1
+  # Guaranteed part: works even if the clean above failed.
+  reset_build_state
+  echo "state/cache reset done" >> "$REBUILD_LOG"
+}
