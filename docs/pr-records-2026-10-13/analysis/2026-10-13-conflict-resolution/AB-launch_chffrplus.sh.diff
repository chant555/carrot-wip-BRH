+  if [ ! -L "$SCONS_CACHE" ] && [ -e "$SCONS_CACHE/config.lock" ] && ! rm -f "$SCONS_CACHE/config.lock"; then
     sudo -n rm -f "$SCONS_CACHE/config.lock"
   fi
   [ -e "$SCONS_CACHE" ] || [ -L "$SCONS_CACHE" ] || return 0
